# URL base de la API. Déjala vacía para usar rutas relativas (/api/...):
# - en desarrollo, Vite reenvía /api y /socket.io al backend (ver vite.config.js);
# - en producción, CloudFront reenvía /api/* y /socket.io/* a EC2.
VITE_API_URL=

# Solo desarrollo: a dónde reenvía el proxy de Vite /api y /socket.io.
VITE_DEV_API_TARGET=http://localhost:3000

# Número de WhatsApp de la papelería (formato internacional sin "+"), usado en el pie del catálogo.
VITE_WHATSAPP_NUMBER=
