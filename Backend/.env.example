# Copia este archivo como .env y completa los valores. .env NUNCA se sube al repositorio.

NODE_ENV=development
PORT=3000

# Cadena de conexión de MongoDB Atlas (cluster M0, us-east-1).
# Cópiala desde Atlas → Connect → Drivers y pégala SOLO en tu .env (nunca en este archivo).
# Para desarrollo local sin credenciales puedes usar: mongodb://127.0.0.1:27017/jeanfabri
MONGODB_URI=

# Secreto para firmar los JWT (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Duración de la sesión: una jornada.
JWT_EXPIRES_IN=8h
# Costo de bcrypt (10 es el equilibrio habitual entre seguridad y velocidad).
BCRYPT_ROUNDS=10

# Orígenes permitidos por CORS, separados por coma. En producción déjalo vacío:
# CloudFront sirve frontend y API desde el mismo dominio. En desarrollo el proxy
# de Vite también evita CORS, así que normalmente queda vacío.
CORS_ORIGIN=
# Proxies de confianza delante de la API (CloudFront → EC2 = 1).
TRUST_PROXY=1
# Intentos fallidos de login permitidos por IP cada 15 minutos.
LOGIN_RATE_LIMIT=10

# S3 (incremento 2). En EC2 las credenciales vienen del rol de IAM: no pongas llaves aquí.
AWS_REGION=us-east-1
S3_BUCKET_IMAGES=
